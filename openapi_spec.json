{
  "openapi": "3.1.0",
  "info": {
    "title": "News2 Qsofa Early Warning API",
    "description": "FastAPI service with deterministic NEWS2, qSOFA and SIRS scoring and separate demonstration agent endpoints.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Read JSON service counters",
        "responses": {
          "200": {
            "description": "JSON with count and status fields"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query the deterministic mock assistant (not clinical decision support)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate NEWS2, qSOFA and SIRS from observations",
        "description": "No identifier is accepted or persisted; validate appropriate clinical context separately.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rr": {
                    "type": "number"
                  },
                  "spo2": {
                    "type": "number"
                  },
                  "spo2_scale": {
                    "type": "integer",
                    "default": 1,
                    "enum": [
                      1,
                      2
                    ]
                  },
                  "supplemental_o2": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 0
                  },
                  "systolic_bp": {
                    "type": "number"
                  },
                  "heart_rate": {
                    "type": "number"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "avpu": {
                    "type": "string",
                    "enum": [
                      "A",
                      "C",
                      "V",
                      "P",
                      "U"
                    ]
                  },
                  "wcc": {
                    "type": "number",
                    "nullable": true
                  }
                },
                "required": [
                  "rr",
                  "spo2",
                  "systolic_bp",
                  "heart_rate",
                  "temperature",
                  "avpu"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Component scores, totals, and warnings"
          },
          "422": {
            "description": "Invalid or missing observations"
          }
        }
      }
    }
  }
}
